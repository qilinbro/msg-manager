# 示例说明，不自动读取此文件。请在启动终端设置环境变量。
SOCIALD_ADDR=127.0.0.1:17890
# 必填：使用至少 32 字符的随机值；不提交真实令牌。
SOCIALD_API_TOKEN=

# 可选：自己的 QQ OneBot v11 服务。三个值均留空时不接入。
# 支持本机 HTTP API 或正向 WebSocket 服务端，不接受公网地址。
# 例如 http://127.0.0.1:3000 或 ws://127.0.0.1:3001
# OneBot 访问令牌不是 NapCat WebUI 密码，也不是本产品 API 令牌。
QQ_ONEBOT_URL=
QQ_ONEBOT_ACCESS_TOKEN=
QQ_ONEBOT_ACCOUNT_ID=
