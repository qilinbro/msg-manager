# 示例说明，不自动读取此文件。请在启动终端设置环境变量。
SOCIALD_ADDR=127.0.0.1:17890
# 必填：使用至少 32 字符的随机值；不提交真实令牌。
SOCIALD_API_TOKEN=

# 可选：统一消息中心的加密数据库。两个变量一起配置，密钥为32随机字节的64位十六进制。
# 数据库路径必须是本机绝对路径；密钥需自行安全保管，不能用产品访问令牌替代。
SOCIALD_DATABASE_PATH=
SOCIALD_DATABASE_KEY=

# 可选：自己的 QQ OneBot v11 服务。三个值均留空时不接入。
# 支持本机 HTTP API 或正向 WebSocket 服务端，不接受公网地址。
# 例如 http://127.0.0.1:3000 或 ws://127.0.0.1:3001
# OneBot 访问令牌不是 NapCat WebUI 密码，也不是本产品 API 令牌。
QQ_ONEBOT_URL=
QQ_ONEBOT_ACCESS_TOKEN=
QQ_ONEBOT_ACCOUNT_ID=

# 可选：IMAP 隐式TLS邮箱，只接收不发信。所有值留空则不接入。
# 本轮优先QQ/163/支持授权码的企业邮箱；不支持Outlook/M365 OAuth。
# QQ常见主机imap.qq.com；企业邮箱以自己后台显示为准，不能混用个人主机。
# PASSWORD填写邮箱应用授权码，不是本产品访问令牌；不要提交真实值。
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=
EMAIL_IMAP_USERNAME=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_FOLDER=
EMAIL_IMAP_LIMIT=
